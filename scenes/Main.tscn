theme_override_colors/font_color = Color(1, 0.94, 0.84, 1)
theme_override_font_sizes/font_size = 34
text = "1. Chọn mệnh giá Lộc.\n2. Chạm một hoặc nhiều linh vật.\n3. Chạm tô để lắc và xem kết quả.\n\nMỗi linh vật xuất hiện sẽ trả Lộc theo số lần xuất hiện. Các cặp Bầu–Cá, Cua–Tôm và Gà–Nai nhận thêm 50.000 Lộc khi được chọn và cùng xuất hiện.\n\nLộc chỉ là điểm ảo: không nạp tiền, không đổi thưởng và không có giá trị thực."

[node name="Spacer" type="Control" parent="RulesPopup/Margin/Content"]
